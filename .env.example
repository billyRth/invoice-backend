# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Groq API key. Get one at https://console.groq.com
GROQ_API_KEY=gsk_your_key_here

# Port the server listens on locally. Render sets this automatically in production.
PORT=3000

# Comma-separated list of origins allowed to call the API.
# Leave unset to allow all origins (fine for local dev; tighten before real users).
# Example: ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# ALLOWED_ORIGINS=
